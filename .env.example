# ==============================================================================
# EchoFence Environment Configuration Example
# Copy this file to .env.local and populate with your credentials.
# NEVER commit .env.local or real API keys to version control.
# ==============================================================================

# --- Rime Speech Synthesis (Required for Live Voice Output) ---
# Your Rime API key from https://rime.ai/
# When omitted or left as placeholder, EchoFence automatically operates in safe fallback/mock mode.
RIME_API_KEY=your_rime_api_key_here

# Rime model selection (default: mist)
RIME_MODEL=mist

# Rime voice / speaker persona (default: amber)
RIME_VOICE=amber

# Rime language code (default: eng)
RIME_LANGUAGE=eng

# Rime HTTP synthesis endpoint (default: https://users.rime.ai/v1/rime-tts)
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts

# Audio format returned by Rime (default: mp3)
RIME_AUDIO_FORMAT=mp3

# Provider mode override: "real" to enforce live API, "mock" for deterministic offline testing
# Default behavior: uses "real" if RIME_API_KEY is configured, otherwise falls back to "mock"
RIME_PROVIDER_MODE=real

# --- Application & Development ---
# Base application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Force-enable demo controls in production builds (optional, default: false in production)
DEMO_MODE=true
